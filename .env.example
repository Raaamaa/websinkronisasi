# ==============================================================================
# WEBSINKRONISASI — CONTOH KONFIGURASI ENVIRONMENT (.env.example)
# Sistem Matching Bukti Dukung ke Lembar Kerja (LK)
# ==============================================================================
# Catatan Keamanan:
# Salin berkas ini menjadi .env (cp .env.example .env) dan sesuaikan nilainya.
# Seluruh data sensitif (password, secret key, token) wajib diganti dan tidak
# boleh dibagikan ke publik atau dicatat ke version control.
# ==============================================================================

# --- Konfigurasi Aplikasi Inti ---
APP_NAME="Websinkronisasi"
APP_ENV=local
APP_KEY=base64:PLACEHOLDER_JALANKAN_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# --- Logging & Pemantauan ---
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Basis Data (PostgreSQL 15+ Docker / On-Premise) ---
# Mengacu pada spesifikasi DATABASE.md
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=websinkronisasi
DB_USERNAME=postgres
DB_PASSWORD=YOUR_STRONG_POSTGRES_PASSWORD_PLACEHOLDER

# --- Cache & Antrean (Redis 7+ Docker / On-Premise) ---
# Mengacu pada spesifikasi ARCHITECTURE.md (NFR-06, MATCH-01)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=YOUR_STRONG_REDIS_PASSWORD_PLACEHOLDER
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# --- Akun Dummy Awal Super Admin (Seeder Lokal) ---
# Mengacu pada spesifikasi PRD (AUTH-03, AUTH-04, D6, AC-03)
# Akun ini dibuat lewat seeder dan dipaksa ganti password pada saat login pertama kali.
SEEDER_SUPERADMIN_NAME="Super Admin Inisial"
SEEDER_SUPERADMIN_EMAIL=superadmin@kantor.local
SEEDER_SUPERADMIN_PASSWORD=PLACEHOLDER_PASSWORD_AWAL_SUPERADMIN_123!

# --- Abstraksi SSO Kantor (SSOProviderInterface) ---
# Mengacu pada spesifikasi RBAC.md (NFR-16, AUTH-01)
# Opsi driver: 'mock' (pengujian lokal tanpa server SSO), 'oidc' (OpenID Connect), 'saml2' (SAML 2.0)
SSO_DRIVER=mock
SSO_CLIENT_ID=YOUR_SSO_CLIENT_ID_PLACEHOLDER
SSO_CLIENT_SECRET=YOUR_SSO_CLIENT_SECRET_PLACEHOLDER
SSO_REDIRECT_URI="${APP_URL}/auth/sso/callback"
SSO_BASE_URL=https://sso.kantor.go.id
SSO_AUTHORIZATION_URL=https://sso.kantor.go.id/oauth/authorize
SSO_TOKEN_URL=https://sso.kantor.go.id/oauth/token
SSO_USERINFO_URL=https://sso.kantor.go.id/oauth/userinfo

# --- Mesin Ekstraksi Teks & OCR ---
# Mengacu pada spesifikasi ARCHITECTURE.md (A5, BD-07)
TESSERACT_PATH=/usr/bin/tesseract
TESSERACT_LANG=ind
PDFTOTEXT_PATH=/usr/bin/pdftotext

# --- Penyimpanan Berkas Bukti Dukung (Private Storage) ---
# Mengacu pada spesifikasi PRD (NFR-04, BD-10)
# Berkas disimpan di storage privat (bukan public) dan diakses hanya melalui otorisasi controller.
FILESYSTEM_DISK=private
EVIDENCE_PRIVATE_PATH=storage/app/private/evidence
EVIDENCE_MAX_FILE_SIZE_MB=20

# --- Parameter Ambang Batas Algoritma Matching ---
# Mengacu pada spesifikasi MATCHING_ALGORITHM.md (MATCH-11)
MATCHING_SIMILARITY_THRESHOLD=75.0
MATCHING_CONTENT_WEIGHT=0.3
MATCHING_TITLE_WEIGHT=0.7

# --- Pengaturan Email / Notifikasi (Opsional) ---
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@websinkronisasi.kantor.local"
MAIL_FROM_NAME="${APP_NAME}"

