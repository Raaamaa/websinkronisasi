# Systemd Service Unit untuk Redis Queue Worker Websinkronisasi
# Referensi: NFR-06, NFR-07 (Persistent Daemon dengan Auto-Restart)
# Lokasi Instalasi: /etc/systemd/system/websinkronisasi-worker.service

[Unit]
Description=Laravel Redis Queue Worker (Websinkronisasi)
After=network.target redis-server.service postgresql.service
Requires=redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
Restart=always
RestartSec=5s

WorkingDirectory=/var/www/html
ExecStart=/usr/bin/php /var/www/html/artisan queue:work redis --queue=high,default,low --sleep=3 --tries=3 --timeout=120 --max-jobs=1000 --max-time=3600

# Manajemen Sinyal Berhenti Anggun (Graceful Stop)
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=60

# Pengamanan Lingkungan Eksekusi
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true

# Batas Resource Memori
MemoryMax=1G
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
