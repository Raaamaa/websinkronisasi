FROM php:8.3-fpm-alpine

# Install build & runtime dependencies, OCR, and build tools
RUN apk add --no-cache \
    postgresql-dev \
    libzip-dev \
    libpng-dev \
    libjpeg-turbo-dev \
    freetype-dev \
    icu-dev \
    tesseract-ocr \
    tesseract-ocr-data-ind \
    poppler-utils \
    git \
    unzip \
    linux-headers \
    $PHPIZE_DEPS

# Configure and install PHP extensions
RUN docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) \
        pdo_pgsql \
        pgsql \
        zip \
        gd \
        intl \
        bcmath \
        pcntl \
        opcache \
    && pecl channel-update pecl.php.net \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && apk del $PHPIZE_DEPS

# Copy Composer from official image
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Configure user
ARG PUID=1000
ARG PGID=1000
RUN addgroup -g ${PGID} appuser && \
    adduser -D -u ${PUID} -G appuser appuser

WORKDIR /var/www/html

# Install dependencies inside image (--no-dev untuk produksi)
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --no-scripts --prefer-dist --optimize-autoloader

COPY . .

# Adjust storage and bootstrap permissions
RUN chown -R appuser:appuser /var/www/html/storage /var/www/html/bootstrap/cache

USER appuser

EXPOSE 9000

CMD ["php-fpm"]

